{
  "name": "study-vocabulary",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Personal English vocabulary trainer — word/definition matching + word bank",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && vite build && npm run build:api",
    "build:api": "node scripts/build-api.mjs",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:import-firebase": "tsx scripts/import-firebase.ts",
    "db:migrate-senses": "tsx scripts/migrate-word-senses.ts",
    "db:link-families": "tsx scripts/link-word-families.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.7",
    "@hono/node-server": "^1.19.11",
    "antd": "^5.29.3",
    "dotenv": "^16.4.5",
    "hono": "^4.12.9",
    "mongodb": "^6.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1",
    "ts-fsrs": "5.4.2",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "sass": "^1.77.6",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
